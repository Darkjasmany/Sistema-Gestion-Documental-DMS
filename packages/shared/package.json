{
  "name": "@selnic/shared",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Código compartido entre frontend y backend - Schemas y validaciones Zod",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "clean": "rm -rf node_modules dist"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {}
}
