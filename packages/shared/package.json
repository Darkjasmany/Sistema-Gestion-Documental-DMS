{
  "name": "@selnic/shared",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Código compartido - Schemas y validaciones Zod",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./schemas/*": "./src/schemas/*.ts",
    "./models": "./src/models/index.ts",
    "./validations": "./src/validations/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "echo '✅ Shared se usa directo desde src/'",
    "build": "echo '⚠️ Shared no se compila, se bundlea con los apps'",
    "dev1": "tsc --watch --preserveWatchOutput",
    "build1": "tsc",
    "clean": "rm -rf node_modules dist"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {}
}
