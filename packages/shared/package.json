{
  "name": "@selnic/shared",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Código compartido entre frontend y backend - Schemas y validaciones Zod",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./models": {
      "import": "./src/models/index.ts",
      "default": "./dist/models/index.js"
    },
    "./schemas": {
      "import": "./src/schemas/index.ts",
      "default": "./dist/schemas/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf node_modules dist"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {}
}
