{
  "name": "@selnic/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "description": "Backend API de SelNic",
  "scripts": {
    "dev": "tsx --env-file .env --watch src/index.ts",
    "start": "node --env-file .env ./dist/index.js",
    "build": "tsup src/index.ts --format esm --clean --sourcemap",
    "type-check": "tsc --noEmit",
    "sequelize": "sequelize-cli",
    "start1": "NODE_ENV=production node ./dist/index.js",
    "build1": "tsc"
  },
  "dependencies": {
    "@selnic/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.3",
    "morgan": "^1.10.1",
    "sequelize-typescript": "^2.1.6",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6"
  }
}
