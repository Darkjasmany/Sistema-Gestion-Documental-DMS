{
  "name": "selnic-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema Estratégico para la Logística y la Gestión de Negocios Inteligentes - Monorepo con pnpm + Turborepo",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:backend": "turbo run dev --filter=@selnic/backend",
    "dev:frontend": "turbo run dev --filter=@selnic/frontend",
    "dev:shared": "turbo run dev --filter=@selnic/shared",
    "build": "turbo run build",
    "build:shared": "turbo run build --filter=@selnic/shared",
    "build:backend": "turbo run build --filter=@selnic/backend",
    "build:frontend": "turbo run build --filter=@selnic/frontend",
    "lint": "turbo run lint",
    "lint:fix": "eslint . --fix",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "turbo run clean && pnpm clean",
    "reset": "pnpm clean && pnpm install",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "check-format": "prettier --check .",
    "check": "turbo run lint type-check test build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.7.1",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  },
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
